<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/colorPrimary"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/background"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#E5E8FF"
			android:gravity="center_horizontal|top"
			android:orientation="vertical">
			<WebView
				android:id="@+id/webview1"
				android:layout_width="match_parent"
				android:layout_height="0dp" />
			<LinearLayout
				android:id="@+id/app"
				android:layout_width="match_parent"
				android:layout_height="300dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="Select Application"
						android:textSize="28sp"
						android:textColor="#31247E" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear23"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview9"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="Your Discord User ID."
						android:textSize="14sp"
						android:textColor="#31247E"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/userid"
						android:layout_width="180dp"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:background="#F8FAFC"
						android:gravity="left|center_vertical"
						android:text="loading..."
						android:textSize="14sp"
						android:textColor="#0F172A"
						android:singleLine="true" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/spinnerlinear"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="left|center_vertical"
					android:orientation="horizontal">
					<Spinner
						android:id="@+id/appsspinner"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:padding="8dp"
						android:background="#D5D9FE"
						android:spinnerMode="dropdown"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/imageview1"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_marginLeft="8dp"
						android:padding="4dp"
						android:src="@drawable/icon_error_round"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="right|center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.button.MaterialButton
						android:id="@+id/next"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:padding="8dp"
						app:backgroundTint="#31247E"
						android:gravity="center_horizontal|center_vertical"
						android:text="Next"
						android:textSize="10sp"
						android:textColor="#FFFFFF"
						app:cornerRadius="8dp" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/sdk"
				android:layout_width="match_parent"
				android:layout_height="300dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear8"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview4"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="Enable Games SDK"
						android:textSize="28sp"
						android:textColor="#31247E" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="left|center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview5"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="8dp"
						android:paddingRight="8dp"
						android:paddingBottom="8dp"
						android:text="This will enable Games SDK for the selected application."
						android:textSize="12sp"
						android:layout_weight="1" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/gamessdk"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:padding="8dp"
						app:backgroundTint="#D32F2F"
						android:gravity="center_horizontal|center_vertical"
						android:text="Enable"
						android:textSize="10sp"
						android:textColor="#FFFFFF"
						app:cornerRadius="8dp" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="left|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/back"
						android:layout_width="35dp"
						android:layout_height="25dp"
						android:padding="4dp"
						android:background="#31247E"
						android:src="@drawable/icon_arrow_back_round"
						android:scaleType="fitCenter" />
					<LinearLayout
						android:id="@+id/linear25"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:orientation="horizontal"
						android:layout_weight="1" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/next1"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:padding="8dp"
						app:backgroundTint="#31247E"
						android:gravity="center_horizontal|center_vertical"
						android:text="Next"
						android:textSize="10sp"
						android:textColor="#FFFFFF"
						app:cornerRadius="8dp" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/bottoken"
				android:layout_width="match_parent"
				android:layout_height="300dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview6"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="Bot Token"
						android:textSize="28sp"
						android:textColor="#31247E" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="left|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/redirect"
						android:layout_width="35dp"
						android:layout_height="25dp"
						android:padding="2dp"
						android:src="@drawable/icon_launch"
						android:scaleType="fitCenter" />
					<EditText
						android:id="@+id/bottokeninput"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:background="#F8FAFC"
						android:textSize="12sp"
						android:textColor="#020617"
						android:hint="here..."
						android:textColorHint="#94A3B8"
						android:singleLine="true"
						android:layout_weight="1" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btconfirm"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:layout_marginLeft="8dp"
						android:padding="8dp"
						app:backgroundTint="#31247E"
						android:gravity="center_horizontal|center_vertical"
						android:text="Confirm"
						android:textSize="10sp"
						android:textColor="#FFFFFF"
						app:cornerRadius="8dp" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear24"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="left|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/back1"
						android:layout_width="35dp"
						android:layout_height="25dp"
						android:padding="4dp"
						android:background="#31247E"
						android:src="@drawable/icon_arrow_back_round"
						android:scaleType="fitCenter" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/widgetconfig"
				android:layout_width="match_parent"
				android:layout_height="300dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear16"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="Widget Config"
						android:textSize="28sp"
						android:textColor="#31247E" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear20"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:orientation="horizontal">
					<EditText
						android:id="@+id/widgetconfiginput"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:background="#020617"
						android:textSize="12sp"
						android:textColor="#F8FAFC"
						android:lines="8" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear19"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="15dp"
					android:paddingTop="4dp"
					android:paddingRight="15dp"
					android:paddingBottom="4dp"
					android:gravity="right|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/back2"
						android:layout_width="35dp"
						android:layout_height="25dp"
						android:padding="4dp"
						android:background="#31247E"
						android:src="@drawable/icon_arrow_back_round"
						android:scaleType="fitCenter" />
					<LinearLayout
						android:id="@+id/linear26"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:orientation="horizontal"
						android:layout_weight="1" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/refresh"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:layout_marginRight="8dp"
						android:padding="8dp"
						app:backgroundTint="#31247E"
						android:gravity="center_horizontal|center_vertical"
						android:text="Refresh"
						android:textSize="10sp"
						android:textColor="#FFFFFF"
						app:cornerRadius="8dp" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/apply"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:padding="8dp"
						app:backgroundTint="#31247E"
						android:gravity="center_horizontal|center_vertical"
						android:text="Apply"
						android:textSize="10sp"
						android:textColor="#FFFFFF"
						app:cornerRadius="8dp" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear21"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="vertical"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Widgeto."
				android:textSize="60sp"
				android:textStyle="bold"
				android:textColor="#94A3B8"
				android:rotation="-45" />
			<LinearLayout
				android:id="@+id/linear22"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="vertical"
				android:layout_weight="1" />
		</LinearLayout>
	</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
