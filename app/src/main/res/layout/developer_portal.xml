<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear3"
		android:layout_width="match_parent"
		android:layout_height="610dp"
		android:paddingLeft="20dp"
		android:paddingRight="20dp"
		android:paddingBottom="20dp"
		android:background="#E5E8FF"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="70dp"
			android:paddingTop="4dp"
			android:paddingRight="8dp"
			android:paddingBottom="4dp"
			android:gravity="left|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview1"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="DISCORD DEVELOPER PORTAL"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#020617" />
		</LinearLayout>
		<WebView
			android:id="@+id/webview1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginBottom="10dp"
			android:layout_weight="1" />
		<CheckBox
			android:id="@+id/checkbox1"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="left|center_vertical"
			android:text="Remember my login info"
			android:textSize="12sp"
			android:textColor="#020617" />
		<LinearLayout
			android:id="@+id/autofill"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/ac"
				android:layout_width="wrap_content"
				android:layout_height="40dp"
				android:padding="8dp"
				app:backgroundTint="#31247E"
				android:gravity="center_horizontal|center_vertical"
				android:text="Autofill credentials"
				android:textSize="10sp"
				android:textColor="#FFFFFF"
				app:cornerRadius="8dp" />
			<ImageView
				android:id="@+id/del_ac"
				android:focusable="false"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:layout_margin="2dp"
				android:padding="7dp"
				android:background="#31247E"
				android:src="@drawable/icon_delete_round"
				android:scaleType="centerCrop" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
